# Copy to .env.local (gitignored). Public values only, no secrets.
# demo = localStorage mock (default). testnet = real NEAR testnet wallet + drop 1 contract.
# mainnet = REAL NEAR (docs/MAINNET-RUNBOOK.md): NEXT_PUBLIC_DROP1_CONTRACT and NEXT_PUBLIC_TREASURY are required,
# there are no mainnet defaults. One build = one chain.
NEXT_PUBLIC_CHAIN=demo
NEXT_PUBLIC_DROP1_CONTRACT=neargotchi-drop1-ng57.testnet
# shop payments (snacks / energy packs) go here: the team account
# NEXT_PUBLIC_TREASURY=neargotchi-team-ng57.testnet
# optional: NEXT_PUBLIC_RPC_URL=https://rpc.testnet.near.org   (mainnet default: https://rpc.mainnet.near.org)

# Server-only secret for the pet chat (NEAR AI Cloud). Set it in .env.local and in the Vercel project settings.
# Never prefix it with NEXT_PUBLIC_. Without it the chat falls back to the built-in mock.
NEAR_AI_API_KEY=
# optional: NEAR_AI_MODEL=z-ai/glm-5.3-flash
